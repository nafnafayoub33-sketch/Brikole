# Copy to .env and fill in. .env is gitignored — never commit real values.

ENV=development

# MySQL 8 (MariaDB 10.11 also works). Use the pymysql driver.
DATABASE_URL=mysql+pymysql://brikole:devpassword@127.0.0.1:3306/brikole?charset=utf8mb4

# Sign JWTs with a real random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with this placeholder when ENV=production.
SECRET_KEY=dev-only-insecure-key-change-me

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where uploaded photos go in development.
UPLOAD_DIR=var/uploads
